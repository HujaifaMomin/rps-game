<!DOCTYPE html>
<html>
<head>
  <title>Rock Paper Scissors</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #dfe9f3;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .game-box {
      background-color: white;
      padding: 40px 50px;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
      text-align: center;
      width: 350px;
    }

    h1 {
      color: #333;
      margin-bottom: 5px;
    }

    p {
      color: #666;
      margin-top: 0;
      margin-bottom: 25px;
    }

    .buttons {
      margin-bottom: 20px;
    }

    button {
      font-size: 17px;
      padding: 10px 18px;
      margin: 5px;
      border: none;
      border-radius: 6px;
      background-color: #4CAF50;
      color: white;
      cursor: pointer;
      transition: background-color 0.2s ease, transform 0.1s ease;
    }

    button:hover {
      background-color: #45a049;
    }

    button:active {
      transform: scale(0.96);
    }

    #result {
      margin-top: 20px;
      font-size: 17px;
      color: #222;
      min-height: 70px;
      background-color: #f7f7f7;
      border-radius: 8px;
      padding: 12px;
      line-height: 1.5;
    }

    #score {
      margin-top: 15px;
      font-size: 14px;
      color: #777;
      border-top: 1px solid #eee;
      padding-top: 12px;
    }

    #resetBtn {
      margin-top: 15px;
      background-color: #999;
      font-size: 14px;
      padding: 7px 14px;
    }

    #resetBtn:hover {
      background-color: #808080;
    }
  </style>
</head>
<body>

  <div class="game-box">
    <h1>Rock Paper Scissors</h1>
    <p>Click a button to play!</p>

    <div class="buttons">
      <button onclick="play('Rock')">Rock</button>
      <button onclick="play('Paper')">Paper</button>
      <button onclick="play('Scissors')">Scissors</button>
    </div>

    <div id="result">Make your move!</div>
    <div id="score">Wins: 0 | Losses: 0 | Ties: 0</div>

    <button id="resetBtn" onclick="resetGame()">Reset</button>
  </div>

  <script>
    // keep track of score
    let wins = 0;
    let losses = 0;
    let ties = 0;

    function pickComputerMove() {
      let choices = ['Rock', 'Paper', 'Scissors'];
      let randomIndex = Math.floor(Math.random() * choices.length);
      return choices[randomIndex];
    }

    function play(userChoice) {
      let computerChoice = pickComputerMove();
      let result = "";

      if (userChoice === computerChoice) {
        result = "It's a tie!";
        ties++;
      } else if (
        (userChoice === "Rock" && computerChoice === "Scissors") ||
        (userChoice === "Paper" && computerChoice === "Rock") ||
        (userChoice === "Scissors" && computerChoice === "Paper")
      ) {
        result = "You win!";
        wins++;
      } else {
        result = "You lose!";
        losses++;
      }

      document.getElementById("result").innerHTML =
        "You picked <b>" + userChoice + "</b><br>" +
        "Computer picked <b>" + computerChoice + "</b><br>" +
        result;

      document.getElementById("score").innerHTML =
        "Wins: " + wins + " | Losses: " + losses + " | Ties: " + ties;
    }

    function resetGame() {
      wins = 0;
      losses = 0;
      ties = 0;

      document.getElementById("result").innerHTML = "Make your move!";
      document.getElementById("score").innerHTML = "Wins: 0 | Losses: 0 | Ties: 0";
    }
  </script>

</body>
</html>
